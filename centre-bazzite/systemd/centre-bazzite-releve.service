[Unit]
Description=Health Hub : relevé des versions et de l'état de la machine
Documentation=file://%h/developer/toolbox/centre-bazzite/bin/centre-bazzite

[Service]
Type=oneshot
# mode jeu : les commandes lourdes ci-dessous sont reportées pendant un jeu (réglage « taches »), rafraichir devient léger
Environment=HEALTH_HUB_RELEVE=1
# d'abord, la restauration de secours : service du mode jeu mort, partie ouverte, plus de jeu → bureau remis comme avant
ExecStart=-%h/.local/bin/centre-bazzite modejeu restaurer --si-orphelin
ExecStart=%h/.local/bin/centre-bazzite releve
# page Démarrage : durée, ce qui ralentit, ce qui se lance tout seul (léger, jamais reporté pendant un jeu) ;
# avant controles et rafraichir, pour que le point « démarrage plus lent » soit à jour ; un échec ne fait pas
# échouer le relevé
ExecStart=-%h/.local/bin/centre-bazzite demarrage
# contrôles lents (réseau, parcours de dossiers) au plus une fois par 20 h ; un échec ne saute pas rafraichir
ExecStart=-%h/.local/bin/centre-bazzite controles --si-perime
ExecStart=%h/.local/bin/centre-bazzite rafraichir
# disques et volumes (page Stockage), puis bibliothèques de jeux (page Jeux) ; un échec ne fait pas échouer le relevé
ExecStart=-%h/.local/bin/centre-bazzite stockage
ExecStart=-%h/.local/bin/centre-bazzite jeux
# analyse des volumes dont le résumé a plus de 7 jours ou a été interrompu par un jeu (reprise après la partie) :
# lancée dans l'unité health-hub-analyse, elle rend la main aussitôt ; reportée sans échec pendant un jeu
ExecStart=-%h/.local/bin/centre-bazzite analyser --si-perime
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
