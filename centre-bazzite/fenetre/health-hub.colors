# Palette KDE de la fenêtre Health Hub : celle de GitHub Hub, toujours sombre, accent émeraude (Ruling V57).
# Traduction de qml/Style.qml (qui fait référence, voir tests/test_apparence.py) pour ce que dessine le style KDE
# hors de la racine de Main.qml : dialogues, infobulles, champs, barres de défilement, notifications.
# Posée sur l'application par apparence.appliquer() (propriété KDE_COLOR_SCHEME_PATH, lue par KColorScheme).

[General]
ColorScheme=HealthHub
Name=Health Hub

[KDE]
contrast=4

[ColorEffects:Disabled]
Color=11,14,20
ColorAmount=0
ColorEffect=0
ContrastAmount=0.6
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=false
Enable=false

